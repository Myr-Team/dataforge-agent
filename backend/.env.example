# DataForge backend configuration template.
# Copy to .env (git-ignored) and fill in your own values. Never commit real keys.
# In Azure, prefer Managed Identity over keys where possible.

# ---- Azure OpenAI (chat / embeddings / image) ----
AZURE_OPENAI_ENDPOINT=https://your-foundry-account.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
DF_CHAT_DEPLOYMENT=gpt-5.1
DF_EMBEDDING_DEPLOYMENT=text-embedding-3-small
DF_IMAGE_DEPLOYMENT=gpt-image-2

# ---- Azure AI Foundry (Agent Service) ----
# Project endpoint: https://<account>.services.ai.azure.com/api/projects/<project>
DF_BING_CONNECTION_ID=

# ---- Azure AI Search (hybrid RAG) ----
SEARCH_ENDPOINT=https://your-search-svc.search.windows.net
SEARCH_KEY=
SEARCH_INDEX_NAME=dataforge-workspaces
DF_SEARCH_SERVICE=your-search-svc

# ---- Azure Blob Storage (workspaces / runs / artifacts) ----
STORAGE_ACCOUNT_NAME=yourstorageacct
# DF_STORAGE_ACCOUNT remains a backward-compatible alias.
DF_STORAGE_KEY=
DF_WORKSPACE_CONTAINER=dataforge-workspaces

# ---- Governance audit ledger ----
# Local append-only storage is allowed only when this explicit switch is set.
DF_AUDIT_LOCAL_MODE=1
DF_AUDIT_LOCAL_DIR=generated-outputs/audit
# Production receives these from a Key Vault-backed Container Apps secret reference.
DF_AUDIT_HMAC_ACTIVE_KEY_ID=
DF_AUDIT_HMAC_KEYS=
DF_AUDIT_CONTAINER=dataforge-audit
DF_AUDIT_STORAGE_ACCOUNT_RESOURCE_ID=

# ---- Azure Cache for Redis (feasibility result cache) ----
DF_REDIS_URL=
DF_DISABLE_REDIS_CACHE=0

# ---- Azure AI Content Safety (Prompt Shield) ----
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=

# ---- Azure AI Speech (audio summary) ----
SPEECH_KEY=
SPEECH_REGION=eastus2

# ---- MCP market tool ----
MCP_MARKET_URL=

# ---- Observability (App Insights / OpenTelemetry) ----
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=dataforge-backend
LOG_LEVEL=INFO

# ---- Text model routing (server-owned allowlist) ----
# Safe example only. Replace deployments with your own non-secret names.
DF_MODEL_ROUTE_ALLOWLIST=[{"id":"analysis","deployment":"gpt-5-1-prod","label":"Analysis","capabilities":["analysis","chat","research"]},{"id":"chat","deployment":"gpt-5-mini-chat","label":"Chat","capabilities":["chat"]},{"id":"followup","deployment":"gpt-5-mini-followup","label":"Follow-up","capabilities":["followup"]}]
DF_DEFAULT_MODEL_ROUTE=analysis

# ---- Offline evaluation gate for candidate follow-up optimization ----
# Path to a sanitized JSON summary generated offline; do not point this at raw prompts or answers.
DF_CONTEXT_EVALUATION_SUMMARY_PATH=eval/context_optimization_summary.json
DF_CONTEXT_EVALUATION_STALE_DAYS=30

# ---- Feature flags (Microsoft Agent Framework audit<->revise loop) ----
DF_USE_MAF=1                 # enable MAF conditional workflow; 0 falls back to legacy path
DF_MAF_MAX_REVISIONS=2       # bounded revision rounds
DF_AUDIT_STRICT_GATE=0       # 1 restores the legacy conservative audit gate
DF_AGENT_RUNTIME=responses   # Azure OpenAI Responses API
DF_WEB_MARKET=1              # enable Foundry native web search for market research
# Separate autonomous workspace analysis runs from human conversations. Keep 0
# during rollback; enable 1 only after candidate validation with the matching UI.
DF_SEPARATE_ANALYSIS_CONVERSATIONS=0

# ---- Native AI FinOps Portal ----
# Read capability and production governance execution are deliberately separate.
DF_FINOPS_READ_ENABLED=0
DF_FINOPS_ACTIONS_ENABLED=0
DF_FINOPS_FOUNDRY_TRACE_LINK_TEMPLATE=
# HMAC key used only to derive tenant, actor, request, and correlation references.
# Store the real value in Key Vault; never expose it to the browser.
DF_FINOPS_HMAC_SECRET=
# Use the additive df_finops Azure SQL schema after running:
#   python -m backend.finops.migrate
DF_FINOPS_SQL_ENABLED=0
# Provider configuration is write-only; routing remains disabled until a
# separate approval and release explicitly enable it.
DF_PROVIDER_CONNECTORS_ENABLED=0
DF_AWS_BEDROCK_CONNECTOR_ENABLED=0
DF_EXTERNAL_PROVIDER_ROUTING_ENABLED=0
# Redis is query acceleration only; ledger and rollups remain in Azure SQL.
DF_FINOPS_QUERY_CACHE_TTL_SECONDS=60
# Azure SQL reuses the lineage managed-identity connection settings.
LINEAGE_SQL_SERVER=
LINEAGE_SQL_DATABASE=
# External jobs: APIM reconciliation every 5 minutes, rollups every hour,
# and request-fact retention daily.
DF_AZURE_MONITOR_LOGS_WORKSPACE_ID=
DF_AZURE_MONITOR_CLIENT_ID=
DF_FINOPS_APIM_BACKFILL_MINUTES=10
DF_FINOPS_ROLLUP_REFRESH_HOURS=48
DF_FINOPS_RETENTION_DAYS=90
# Optional server-owned link. The only supported placeholder is
# {correlation_id}; the host must be portal.azure.com or portal.azure.cn.
DF_FINOPS_AZURE_MONITOR_LINK_TEMPLATE=
# Optional server-owned workspace -> APIM target map. This is never accepted
# from a public FinOps write API.
# Example value:
# {"workspace-id":{"subscription_id":"00000000-0000-0000-0000-000000000000","resource_group":"rg","service_name":"apim-name","api_id":"dataforge","gateway_url":"https://gateway.example.com/health","managed_identity_scope":"api://dataforge/.default"}}
DF_FINOPS_APIM_TARGETS_JSON={}
DF_FINOPS_APIM_TIMEOUT_SECONDS=20
