server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /icons/ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, stale-while-revalidate=604800";
    }

    location = /dataforge-logo.png {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=2592000, stale-while-revalidate=604800" always;
    }

    location /api/ {
        proxy_pass ${DF_BACKEND_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-MS-CLIENT-PRINCIPAL $http_x_ms_client_principal;
        proxy_set_header X-MS-CLIENT-PRINCIPAL-ID $http_x_ms_client_principal_id;
        proxy_set_header X-MS-CLIENT-PRINCIPAL-NAME $http_x_ms_client_principal_name;
        proxy_set_header X-MS-TOKEN-AAD-ACCESS-TOKEN $http_x_ms_token_aad_access_token;
        proxy_set_header X-MS-TOKEN-AAD-ID-TOKEN $http_x_ms_token_aad_id_token;
        proxy_set_header X-DataForge-Trusted-Tenant "${DF_WORKSPACE_OWNER_TENANT_ID}";
        proxy_set_header X-DataForge-Proxy-Secret "${DF_WEB_PROXY_SECRET}";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1200s;
        proxy_send_timeout 1200s;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires -1;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
