# Copy to terraform.tfvars (git-ignored) and fill in your own values.
# This file carries NO real account identifiers.

subscription_id = "00000000-0000-0000-0000-000000000000"

# Globally-unique names you control:
storage_account_name = "yourstorageacct"   # 3-24 lowercase alphanumerics
audit_immutability_locked = true            # irreversible; required before production mutations
audit_legal_hold_tag = "dataforgeaudit"     # indefinite hold; required before production mutations
audit_hmac_active_key_id = "v1"
audit_hmac_scope_key_id = "v1"              # retain this key across active signing-key rotation
audit_key_vault_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/your-rg/providers/Microsoft.KeyVault/vaults/your-vault"
audit_hmac_keyring_secret_uri = "https://your-vault.vault.azure.net/secrets/dataforge-audit-hmac-keys"
search_service_name  = "your-search-svc"
speech_account_name  = "your-speech-svc"
acr_name             = "youracr"

backend_image = "youracr.azurecr.io/dataforge-backend:<tag>"
mcp_image     = "youracr.azurecr.io/dataforge-mcp:<tag>"

# Existing Azure AI Foundry account to reuse:
foundry_resource_group_name = "your-foundry-rg"
foundry_account_name        = "your-foundry-account"
foundry_endpoint            = "https://your-foundry-account.services.ai.azure.com/api/projects/your-foundry-project"
openai_endpoint             = "https://your-foundry-account.openai.azure.com/"

# Secrets — supply at apply time, never commit:
# speech_key = "..."
# search_key = "..."
# The Key Vault secret above is JSON such as {"v1":"<base64-32+-byte-key>"}.
# Terraform creates a dedicated identity and grants it Key Vault Secrets User on audit_key_vault_id.
